          }
        }
      }
    },
    "Find the other activities on this route and see how your pace on it developed. This downloads up to ten recordings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finde die anderen Aktivitäten auf dieser Strecke und sieh, wie sich dein Tempo darauf entwickelt hat. Dafür werden bis zu zehn Aufzeichnungen geladen."
          }
